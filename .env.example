# Database connection (required)
# Use your PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/austin_vet_finder"

# Admin password for /admin dashboard (optional, default: admin123)
ADMIN_PASSWORD="admin123"

# Google Places API key for clinic discovery (optional)
# Get one at: https://console.cloud.google.com/
# Enable: Places API
GOOGLE_PLACES_API_KEY=""

# Node environment
NODE_ENV="development"
