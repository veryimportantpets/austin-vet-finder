{
  "name": "de-connect",
  "version": "1.0.0",
  "description": "Veterinary PIMS Data Connector - Export Automation Platform",
  "private": true,
  "workspaces": [
    "agent/*",
    "cloud/*",
    "wizard",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:agent": "npm run build --workspace=agent/contracts --workspace=agent/runner --workspace=agent/service",
    "build:cloud": "npm run build --workspace=cloud/api --workspace=cloud/worker",
    "build:wizard": "npm run build --workspace=wizard",
    "dev:service": "npm run dev --workspace=agent/service",
    "dev:api": "npm run dev --workspace=cloud/api",
    "dev:wizard": "npm run dev --workspace=wizard",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
